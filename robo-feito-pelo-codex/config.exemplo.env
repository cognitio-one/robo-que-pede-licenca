# Copie para config.env. Preencha somente a IA e as redes que vai usar.
IA=claude
CLAUDE_MODELO=claude-sonnet-5-5
ANTHROPIC_API_KEY=COLE_SUA_CHAVE_CLAUDE
OPENAI_MODELO=gpt-6.2-sol
OPENAI_API_KEY=COLE_SUA_CHAVE_OPENAI
LINKEDIN_ACCESS_TOKEN=COLE_SEU_TOKEN_LINKEDIN
FACEBOOK_PAGE_ID=SEU_ID_DA_PAGINA
FACEBOOK_PAGE_ACCESS_TOKEN=COLE_SEU_TOKEN_DE_PAGINA
INSTAGRAM_ACCESS_TOKEN=COLE_SEU_TOKEN_INSTAGRAM
# Data em que gerou ou renovou o token de longa duração: dd/mm/aaaa.
INSTAGRAM_TOKEN_CRIADO_EM=PREENCHA_A_DATA
# Apps novos da Meta (login unificado): o número da conta do Instagram que aparece no painel do app,
# embaixo do nome da conta. Com ele preenchido, a data acima não é usada (esse token não vence).
INSTAGRAM_USER_ID=SEU_ID_INSTAGRAM
X_CLIENT_ID=SEU_CLIENT_ID
# Deixe vazio para app público. Preencha somente para app confidencial.
X_CLIENT_SECRET=
