# Copie este arquivo para config.env e troque os valores de exemplo pelos seus.
# Nunca compartilhe o config.env.

# Qual inteligência artificial escreve os rascunhos: claude ou openai
IA=claude
# Deixe em branco para usar o modelo sugerido (claude-sonnet-5-5 ou gpt-6.2-sol)
IA_MODELO=claude-sonnet-5-5
ANTHROPIC_API_KEY=cole-aqui-sua-chave-da-anthropic
OPENAI_API_KEY=cole-aqui-sua-chave-da-openai

# LinkedIn (token vale 60 dias; gere no Token Generator)
LINKEDIN_TOKEN=cole-aqui-o-token-do-linkedin

# Facebook (Página)
FACEBOOK_PAGE_ID=cole-aqui-o-id-da-pagina
FACEBOOK_PAGE_TOKEN=cole-aqui-o-token-da-pagina

# Instagram (conta profissional; token vale 60 dias)
INSTAGRAM_TOKEN=cole-aqui-o-token-do-instagram
# Apps novos da Meta (login unificado): o número da conta do Instagram que aparece no painel do app,
# embaixo do nome da conta. Com ele preenchido, o robô usa graph.facebook.com e o token não precisa ser renovado.
INSTAGRAM_USER_ID=cole-aqui-o-numero-da-conta

# X (depois rode: python robo.py autorizar-x)
X_CLIENT_ID=cole-aqui-o-client-id-do-x
# Só se o seu app no X for "confidencial"; senão deixe em branco
X_CLIENT_SECRET=
